# Copy to `.env` and fill in. `.env` is gitignored — never commit it.
# Every app setting is read with the KATHA_ prefix (see src/katha/config.py).
# POSTGRES_PASSWORD has no prefix: it is consumed by docker-compose.yml, not the app.

# ─── Database ────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD is read by docker-compose.yml when it first creates the
# volume. Changing it later does NOT change the password of an existing volume.
POSTGRES_PASSWORD=change-me
KATHA_DATABASE_URL=postgresql://katha:change-me@localhost:5432/katha

# ─── Sarvam ASR (https://sarvam.ai) ──────────────────────────────────────────
# Required. Without it the `asr` stage fails immediately with a clear error.
KATHA_SARVAM_API_KEY=

# Leave these alone unless you know why you're changing them.
#   saaras:v3 MUST be passed explicitly — the SDK still defaults to the legacy
#   saarika:v2.5 and sends it explicitly, so the server-side default never applies.
#   pa-IN is Sarvam's Punjabi code. It is NOT the same as the aligner's (see below).
KATHA_SARVAM_MODEL=saaras:v3
KATHA_SARVAM_MODE=transcribe
KATHA_SARVAM_LANGUAGE=pa-IN
KATHA_NUM_SPEAKERS=2

# The SDK's own wait_until_complete() default is 600s, which will time out on a
# 90-minute clip. 7200 = 2h, matching Sarvam's Batch API per-file cap.
KATHA_SARVAM_TIMEOUT_SECONDS=7200
KATHA_SARVAM_POLL_SECONDS=15

# ─── Forced alignment ────────────────────────────────────────────────────────
# ISO-639-3. NOT `pa`, and deliberately NOT the same as KATHA_SARVAM_LANGUAGE:
# two tools, two standards. Do not unify them.
KATHA_ALIGN_LANGUAGE=pan
KATHA_ALIGN_BATCH_SIZE=8

# ─── Paths ───────────────────────────────────────────────────────────────────
# WATCH_DIR: drop audio here. WORK_DIR: per-clip intermediates + retained native.wav.
# WORK_DIR grows ~520 MB per clip (see SETUP.md § Disk).
KATHA_WATCH_DIR=/srv/media/katha/incoming
KATHA_WORK_DIR=/srv/media/katha/work

# ─── Compute ─────────────────────────────────────────────────────────────────
# `cuda` or `cpu`. On cuda the aligner uses float16; on cpu, float32.
KATHA_DEVICE=cuda

# DeepFilterNet is invoked as a SUBPROCESS by absolute path, never imported —
# it lives in its own venv so its torch pin can't fight the aligner's.
KATHA_DENOISE_ENABLED=true
KATHA_DENOISE_BIN=/opt/venvs/deepfilternet/bin/deepFilter
KATHA_DENOISE_MODEL=DeepFilterNet3

# ─── Worker behaviour ────────────────────────────────────────────────────────
# Sarvam's Batch API caps at 2h per file; a longer clip is rejected before upload.
KATHA_MAX_AUDIO_SECONDS=7200

# Hard ceiling on any ffmpeg/ffprobe/deepFilter call. 4h is deliberately generous:
# CPU denoising of a 2h file can run at or below realtime.
KATHA_SUBPROCESS_TIMEOUT_SECONDS=14400

# Tries per STAGE (the counter resets on each successful stage).
KATHA_MAX_ATTEMPTS=3

# A job stuck in `running` this long is assumed crashed and is requeued.
# MUST exceed SUBPROCESS_TIMEOUT_SECONDS (4h) or a live long-running stage gets
# yanked out from under the worker. 360 min = 6h.
KATHA_STALE_RUNNING_MINUTES=360

# A previously-failed job waits this long before being retried, so a 1-second
# network blip can't burn the whole retry budget in one tight worker loop.
KATHA_RETRY_BACKOFF_SECONDS=300

# ─── API ─────────────────────────────────────────────────────────────────────
# CORS is a BROWSER-ONLY control — curl ignores it entirely. The API has NO
# authentication. Do not expose it beyond localhost until it does.
KATHA_CORS_ORIGIN=http://localhost:3000
